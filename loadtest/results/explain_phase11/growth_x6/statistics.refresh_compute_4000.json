"sql": "WITH first AS \n(SELECT anon_2.id AS id, anon_2.started_at AS started_at, anon_2.raw_score AS raw_score, anon_2.points_possible AS points_possible \nFROM (SELECT attempts.id AS id, attempts.started_at AS started_at, coalesce(attempts.raw_score, %(coalesce_1)s) AS raw_score, attempts.points_possible AS points_possible, row_number() OVER (PARTITION BY attempts.user_id ORDER BY attempts.attempt_no) AS rn \nFROM attempts \nWHERE attempts.assessment_version_id = %(assessment_version_id_1)s::UUID AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND NOT (EXISTS (SELECT * \nFROM enrollments AS test_enrollment \nWHERE test_enrollment.id = attempts.enrollment_id AND test_enrollment.is_test_student IS true))) AS anon_2 \nWHERE anon_2.rn = %(rn_1)s)\n SELECT anon_1.slot, anon_1.qv, avg(anon_1.secs) AS avg_1 \nFROM (SELECT attempt_items.slot AS slot, attempt_items.question_version_id AS qv, EXTRACT(epoch FROM attempt_items.answered_at - coalesce(lag(attempt_items.answered_at) OVER (PARTITION BY attempt_items.attempt_id ORDER BY attempt_items.answered_at), first.started_at)) AS secs \nFROM first JOIN attempt_items ON attempt_items.attempt_id = first.id \nWHERE attempt_items.answered_at IS NOT NULL) AS anon_1 \nWHERE anon_1.secs > %(secs_1)s AND anon_1.secs <= %(secs_2)s GROUP BY anon_1.slot, anon_1.qv",
