"sql": "WITH final_attempts AS MATERIALIZED \n(SELECT attempts.id AS id, attempts.submitted_at AS submitted_at, attempts.assessment_id AS assessment_id, attempts.assessment_version_id AS assessment_version_id, attempts.language AS language \nFROM attempts \nWHERE attempts.user_id = %(user_id_1)s AND attempts.course_id = %(course_id_1)s::UUID AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND attempts.assessment_id IN (%(assessment_id_1_1)s::UUID, %(assessment_id_1_2)s::UUID, %(assessment_id_1_3)s::UUID, %(assessment_id_1_4)s::UUID, %(assessment_id_1_5)s::UUID, %(assessment_id_1_6)s::UUID, %(assessment_id_1_7)s::UUID, %(assessment_id_1_8)s::UUID, %(assessment_id_1_9)s::UUID, %(assessment_id_1_10)s::UUID, %(assessment_id_1_11)s::UUID, %(assessment_id_1_12)s::UUID, %(assessment_id_1_13)s::UUID, %(assessment_id_1_14)s::UUID, %(assessment_id_1_15)s::UUID, %(assessment_id_1_16)s::UUID, %(assessment_id_1_17)s::UUID, %(assessment_id_1_18)s::UUID, %(assessment_id_1_19)s::UUID, %(assessment_id_1_20)s::UUID, %(assessment_id_1_21)s::UUID)), \nr AS \n(SELECT attempt_items.attempt_id AS attempt_id, attempt_items.position AS position, attempt_items.correctness AS correctness, final_attempts.submitted_at AS submitted_at, final_attempts.assessment_id AS assessment_id, final_attempts.assessment_version_id AS version_id, final_attempts.language AS language, bank_questions.topic AS topic, bank_questions.section AS section, row_number() OVER (PARTITION BY question_versions.question_id ORDER BY final_attempts.submitted_at DESC, attempt_items.attempt_id DESC, attempt_items.position DESC) AS rn, max(CASE WHEN (attempt_items.correctness IN (%(correctness_2_1)s, %(correctness_2_2)s)) THEN %(param_1)s ELSE %(param_2)s END) OVER (PARTITION BY question_versions.question_id) AS ever_wrong \nFROM final_attempts JOIN attempt_items ON attempt_items.attempt_id = final_attempts.id JOIN question_versions ON question_versions.id = attempt_items.question_version_id JOIN bank_questions ON bank_questions.id = question_versions.question_id)\n SELECT r.attempt_id, r.position, r.correctness, r.submitted_at, r.assessment_id, r.version_id, r.language, r.topic, r.section, r.rn, r.ever_wrong, attempt_items.attempt_id AS attempt_id_1, attempt_items.position AS position_1, attempt_items.section_pos, attempt_items.slot, attempt_items.question_version_id, attempt_items.choice_order, attempt_items.response, attempt_items.flagged, attempt_items.client_ts, attempt_items.answered_at, attempt_items.correctness AS correctness_1, attempt_items.score, attempt_items.manual_score, attempt_items.feedback, attempt_items.graded_by_id, attempt_items.graded_at \nFROM r JOIN attempt_items ON attempt_items.attempt_id = r.attempt_id AND attempt_items.position = r.position \nWHERE r.rn = %(rn_1)s AND r.correctness IN (%(correctness_3_1)s, %(correctness_3_2)s) ORDER BY r.submitted_at DESC, r.attempt_id DESC, r.position ASC \n LIMIT %(param_3)s",
