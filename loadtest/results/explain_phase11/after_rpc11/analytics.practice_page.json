"sql": "SELECT attempts.assessment_id AS aid, count(*) AS attempts, count(distinct(attempts.enrollment_id)) AS students, avg(CASE WHEN (attempts.points_possible > %(points_possible_1)s AND attempts.raw_score IS NOT NULL) THEN CAST((attempts.raw_score * %(raw_score_1)s) / CAST(attempts.points_possible AS NUMERIC(10, 2)) AS FLOAT) END) AS mean \nFROM attempts \nWHERE attempts.assessment_id IN (%(assessment_id_1_1)s::UUID, %(assessment_id_1_2)s::UUID, %(assessment_id_1_3)s::UUID, %(assessment_id_1_4)s::UUID, %(assessment_id_1_5)s::UUID, %(assessment_id_1_6)s::UUID, %(assessment_id_1_7)s::UUID, %(assessment_id_1_8)s::UUID, %(assessment_id_1_9)s::UUID, %(assessment_id_1_10)s::UUID, %(assessment_id_1_11)s::UUID, %(assessment_id_1_12)s::UUID, %(assessment_id_1_13)s::UUID, %(assessment_id_1_14)s::UUID, %(assessment_id_1_15)s::UUID, %(assessment_id_1_16)s::UUID, %(assessment_id_1_17)s::UUID, %(assessment_id_1_18)s::UUID, %(assessment_id_1_19)s::UUID, %(assessment_id_1_20)s::UUID) AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND NOT (EXISTS (SELECT * \nFROM enrollments AS test_enrollment \nWHERE test_enrollment.id = attempts.enrollment_id AND test_enrollment.is_test_student IS true)) GROUP BY attempts.assessment_id",
