"sql": "WITH first AS \n(SELECT anon_1.id AS id, anon_1.started_at AS started_at, anon_1.raw_score AS raw_score, anon_1.points_possible AS points_possible \nFROM (SELECT attempts.id AS id, attempts.started_at AS started_at, coalesce(attempts.raw_score, %(coalesce_2)s) AS raw_score, attempts.points_possible AS points_possible, row_number() OVER (PARTITION BY attempts.user_id ORDER BY attempts.attempt_no) AS rn \nFROM attempts \nWHERE attempts.assessment_version_id = %(assessment_version_id_1)s::UUID AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND NOT (EXISTS (SELECT * \nFROM enrollments AS test_enrollment \nWHERE test_enrollment.id = attempts.enrollment_id AND test_enrollment.is_test_student IS true))) AS anon_1 \nWHERE anon_1.rn = %(rn_1)s)\n SELECT attempt_items.slot, attempt_items.question_version_id, count(*) AS count_1, sum(CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT)) AS sum_1, sum(CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT) * CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT)) AS sum_2, sum(CAST(first.raw_score AS FLOAT) - CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT)) AS sum_3, sum((CAST(first.raw_score AS FLOAT) - CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT)) * (CAST(first.raw_score AS FLOAT) - CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT))) AS sum_4, sum(CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT) * (CAST(first.raw_score AS FLOAT) - CAST(coalesce(attempt_items.manual_score, attempt_items.score, %(coalesce_1)s) AS FLOAT))) AS sum_5, sum(CASE WHEN (attempt_items.correctness = %(correctness_1)s) THEN %(param_1)s ELSE %(param_2)s END) AS sum_6, sum(CASE WHEN (attempt_items.correctness = %(correctness_2)s) THEN %(param_3)s ELSE %(param_4)s END) AS sum_7, sum(CASE WHEN (attempt_items.correctness = %(correctness_3)s) THEN %(param_5)s ELSE %(param_6)s END) AS sum_8, sum(CASE WHEN (attempt_items.correctness = %(correctness_4)s) THEN %(param_7)s ELSE %(param_8)s END) AS sum_9 \nFROM first JOIN attempt_items ON attempt_items.attempt_id = first.id \nWHERE attempt_items.correctness IS NOT NULL AND attempt_items.correctness != %(correctness_5)s GROUP BY attempt_items.slot, attempt_items.question_version_id",
