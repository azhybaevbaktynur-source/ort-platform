"sql": "SELECT anon_1.b, count(*) AS count_1, sum(anon_1.p) AS sum_1 \nFROM (SELECT CASE WHEN (anon_2.poss <= %(poss_1)s) THEN %(param_1)s WHEN (anon_2.pts * %(pts_1)s < anon_2.poss * %(poss_2)s) THEN %(param_2)s WHEN (anon_2.pts * %(pts_2)s < anon_2.poss * %(poss_3)s) THEN %(param_3)s WHEN (anon_2.pts * %(pts_3)s < anon_2.poss * %(poss_4)s) THEN %(param_4)s WHEN (anon_2.pts * %(pts_4)s < anon_2.poss * %(poss_5)s) THEN %(param_5)s WHEN (anon_2.pts * %(pts_5)s < anon_2.poss * %(poss_6)s) THEN %(param_6)s WHEN (anon_2.pts * %(pts_6)s < anon_2.poss * %(poss_7)s) THEN %(param_7)s WHEN (anon_2.pts * %(pts_7)s < anon_2.poss * %(poss_8)s) THEN %(param_8)s WHEN (anon_2.pts * %(pts_8)s < anon_2.poss * %(poss_9)s) THEN %(param_9)s WHEN (anon_2.pts * %(pts_9)s < anon_2.poss * %(poss_10)s) THEN %(param_10)s ELSE %(param_11)s END AS b, CAST((anon_2.pts * %(pts_10)s) / CAST(anon_2.poss AS NUMERIC(10, 2)) AS FLOAT) AS p \nFROM (SELECT submissions.enrollment_id AS eid, sum(submissions.effective_points) AS pts, sum(submissions.points_possible) AS poss \nFROM submissions JOIN enrollments ON enrollments.id = submissions.enrollment_id JOIN assignments ON assignments.id = submissions.assignment_id LEFT OUTER JOIN assessments ON assessments.id = assignments.assessment_id \nWHERE submissions.course_id IN (SELECT courses.id \nFROM courses \nWHERE courses.organization_id IN (SELECT organizations.id \nFROM organizations \nWHERE (organizations.path = %(path_1)s OR organizations.path LIKE %(path_2)s) AND organizations.deleted_at IS NULL) AND courses.deleted_at IS NULL AND courses.sandbox_for_template_id IS NULL) AND enrollments.course_id IN (SELECT courses.id \nFROM courses \nWHERE courses.organization_id IN (SELECT organizations.id \nFROM organizations \nWHERE (organizations.path = %(path_1)s OR organizations.path LIKE %(path_2)s) AND organizations.deleted_at IS NULL) AND courses.deleted_at IS NULL AND courses.sandbox_for_template_id IS NULL) AND submissions.state = %(state_1)s AND submissions.points_possible > %(points_possible_1)s AND submissions.effective_points IS NOT NULL AND enrollments.role = %(role_1)s AND enrollments.state = %(state_2)s AND enrollments.is_test_student IS false AND (assignments.kind = %(kind_1)s AND assessments.deleted_at IS NULL AND assessments.status = %(status_1)s OR assignments.kind != %(kind_1)s AND assignments.deleted_at IS NULL AND assignments.published IS true) GROUP BY submissions.enrollment_id) AS anon_2 \nWHERE anon_2.poss > %(poss_11)s) AS anon_1 GROUP BY anon_1.b",
