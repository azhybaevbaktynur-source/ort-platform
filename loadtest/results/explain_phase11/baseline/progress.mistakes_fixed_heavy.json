"sql": "WITH r AS \n(SELECT attempt_items.attempt_id AS attempt_id, attempt_items.position AS position, attempt_items.correctness AS correctness, attempts.submitted_at AS submitted_at, attempts.assessment_id AS assessment_id, attempts.assessment_version_id AS version_id, attempts.language AS language, bank_questions.topic AS topic, bank_questions.section AS section, row_number() OVER (PARTITION BY question_versions.question_id ORDER BY attempts.submitted_at DESC, attempt_items.attempt_id DESC, attempt_items.position DESC) AS rn, max(CASE WHEN (attempt_items.correctness IN (%(correctness_2_1)s, %(correctness_2_2)s)) THEN %(param_1)s ELSE %(param_2)s END) OVER (PARTITION BY question_versions.question_id) AS ever_wrong \nFROM attempts JOIN attempt_items ON attempt_items.attempt_id = attempts.id JOIN question_versions ON question_versions.id = attempt_items.question_version_id JOIN bank_questions ON bank_questions.id = question_versions.question_id \nWHERE attempts.user_id = %(user_id_1)s AND attempts.course_id = %(course_id_1)s::UUID AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND attempts.assessment_id IN (%(assessment_id_1_1)s::UUID, %(assessment_id_1_2)s::UUID, %(assessment_id_1_3)s::UUID, %(assessment_id_1_4)s::UUID, %(assessment_id_1_5)s::UUID, %(assessment_id_1_6)s::UUID, %(assessment_id_1_7)s::UUID, %(assessment_id_1_8)s::UUID, %(assessment_id_1_9)s::UUID, %(assessment_id_1_10)s::UUID, %(assessment_id_1_11)s::UUID, %(assessment_id_1_12)s::UUID, %(assessment_id_1_13)s::UUID, %(assessment_id_1_14)s::UUID, %(assessment_id_1_15)s::UUID, %(assessment_id_1_16)s::UUID, %(assessment_id_1_17)s::UUID, %(assessment_id_1_18)s::UUID, %(assessment_id_1_19)s::UUID, %(assessment_id_1_20)s::UUID, %(assessment_id_1_21)s::UUID, %(assessment_id_1_22)s::UUID, %(assessment_id_1_23)s::UUID, %(assessment_id_1_24)s::UUID, %(assessment_id_1_25)s::UUID))\n SELECT r.attempt_id, r.position, r.correctness, r.submitted_at, r.assessment_id, r.version_id,