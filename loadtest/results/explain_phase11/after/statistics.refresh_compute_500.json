"sql": "WITH first AS \n(SELECT anon_1.id AS id, anon_1.started_at AS started_at, anon_1.raw_score AS raw_score, anon_1.points_possible AS points_possible \nFROM (SELECT attempts.id AS id, attempts.started_at AS started_at, coalesce(attempts.raw_score, %(coalesce_1)s) AS raw_score, attempts.points_possible AS points_possible, row_number() OVER (PARTITION BY attempts.user_id ORDER BY attempts.attempt_no) AS rn \nFROM attempts \nWHERE attempts.assessment_version_id = %(assessment_version_id_1)s::UUID AND attempts.status IN (%(status_1_1)s, %(status_1_2)s) AND NOT attempts.is_preview AND NOT (EXISTS (SELECT * \nFROM enrollments AS test_enrollment \nWHERE test_enrollment.id = attempts.enrollment_id AND test_enrollment.is_test_student IS true))) AS anon_1 \nWHERE anon_1.rn = %(rn_1)s)\n SELECT attempt_items.slot, attempt_items.question_version_id, question_versions.type, CAST(attempt_items.response AS TEXT) AS response, count(*) AS count_1 \nFROM first JOIN attempt_items ON attempt_items.attempt_id = first.id JOIN question_versions ON question_versions.id = attempt_items.question_version_id \nWHERE question_versions.type IN (%(type_1_1)s, %(type_1_2)s, %(type_1_3)s, %(type_1_4)s) AND attempt_items.response IS NOT NULL GROUP BY attempt_items.slot, attempt_items.question_version_id, question_versions.type, CAST(attempt_items.response AS TEXT)",
