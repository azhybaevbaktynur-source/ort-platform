# Frontend Environment Configuration (Vercel / Production)
# API Base URL for client and server rewrites
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
# Page CSP: only when public images move from r2.dev to a custom domain. Set and redeploy BEFORE changing the backend's
# R2_PUBLIC_BASE_URL, or students see no images (docs/SECURITY_AUDIT.md).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=""

# Firebase Client Configuration (Optional if using backend JWT auth)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ort-platform-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

