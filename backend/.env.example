# Backend environment: names only, never values (public repository). The real file is backend/.env (the owner's;
# agents never open it) and Render's Environment page. Full list with defaults: app/core/config.py.

# --- Social sign-in (docs/runbooks/GOOGLE_SIGN_IN.md, docs/phases/AUTH_SOCIAL_DESIGN.md 7.1) ---
# The backend's own public origin; redirect_uri = this + /api/v1/auth/google/callback
OAUTH_PUBLIC_BASE_URL=
GOOGLE_SIGN_IN_ENABLED=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Apple: built, switched off (needs the paid Apple Developer Program: owner's decision)
APPLE_SIGN_IN_ENABLED=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# GOOGLE_OAUTH_AUTHORIZE_URL / _TOKEN_URL / _JWKS_URL / _ISSUERS: e2e stub only; production refuses any other value
